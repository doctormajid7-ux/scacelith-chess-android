options.mouse_sensitivity = Mausempfindlichkeit
options.invert_look = Vertikale Achse umkehren
options.handover = Spielerwechsel
options.handover.cut = Harter Schnitt
options.handover.flight = Kameraflug, {0} s
options.handover.help = Zwei Spieler an einem PC: wie die Sicht nach jedem Zug von den Augen des einen Spielers zu denen des anderen wechselt. Der harte Schnitt vermeidet die Kamerabewegung.
options.game_cursor = Spielzeiger
options.game_cursor.help = Am Tisch zeichnet das Spiel einen eigenen Zeiger, der zeigt, was ein Klick bewirkt. Aus: der gewohnte Systempfeil.
options.touch_mode = Touch-Steuerung
options.touch_mode.help = Touchpad: Der Finger bewegt einen Pfeil, ein Tippen klickt an der Pfeilposition, ein ruhiges langes Drücken hält die Taste. Direkt: Der Finger ist der Zeiger, tippen Sie eine Figur und dann ihr Feld an (oder ziehen Sie sie).
