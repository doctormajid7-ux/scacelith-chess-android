<?xml version="1.0" encoding="utf-8"?>
<!--
  Scacelith for Android.

  INTERNET only: the HTTPS transport (Http.java, src/net/transport_android.cpp) downloads the
  coach's voice model and talks to the online server. The game keeps its settings, its log and its
  saved games in the app's private files folder, which needs no permission.

  OpenGL ES 3.2 is required: the renderer is written against the desktop GL 4.6 core API and the
  Android backend (src/gl/gl46_gles.cpp) emulates the part of it ES does not have, but ES 3.2 is
  the floor (shader storage buffers, image load/store, compute, glCopyImageData).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- Diagnostics from adb without a debug build: simpleperf, debuggerd -b, run-as. Remove
             (and the android:debuggable of the release build type in build.gradle.kts) for a store
             release. -->
        <profileable android:shell="true" />

        <activity
            android:name=".ScacelithActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode|navigation|fontScale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
