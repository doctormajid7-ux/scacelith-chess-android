// Auto exposure, pass 2: mean log luminance of the histogram between two percentiles, target
// exposure offset (EV, relative to the renderer's manual EV100) and eye-like adaptation (faster
// towards darker exposure when the scene gets brighter). Clears the histogram for the next frame.
#include "shaders/post/post_common.glsl"
layout(local_size_x = 256) in;
// 'state' keeps a copy of the exposure the image holds: the previous frame's value is read from
// there, because GL ES allows no read-write rgba32f image (only r32 formats may be both).
layout(std430, binding = 5) buffer Histogram { uint bins[256]; vec4 state; };
layout(binding = 0, rgba32f) uniform writeonly image2D oExposure;  // x adapted EV, y target EV, z mean log2 lum, w valid
shared uint sBins[256];
const float LOW_PERCENT = 0.45, HIGH_PERCENT = 0.96;

void main() {
    uint lid = gl_LocalInvocationIndex;
    sBins[lid] = bins[lid];
    bins[lid] = 0u;
    barrier();
    if (lid != 0u) return;
    float total = 0.0;
    for (int i = 0; i < 256; ++i) total += float(sBins[i]);
    float lo = total * LOW_PERCENT, hi = total * HIGH_PERCENT;
    float acc = 0.0, sum = 0.0, cnt = 0.0;
    for (int i = 0; i < 256; ++i) {
        float n = float(sBins[i]);
        float a = clamp(lo - acc, 0.0, n);  // part of this bin below the low percentile
        float b = clamp(acc + n - hi, 0.0, n);  // part above the high percentile
        float use = max(n - a - b, 0.0);
        // Bin i >= 1 is centred at (i - 1) / 254 of the range: exposure_histogram.comp rounds.
        float logL = i == 0 ? EXPO_MIN_LOG : EXPO_MIN_LOG + float(i - 1) / 254.0 * EXPO_RANGE_LOG;
        sum += use * logL;
        cnt += use;
        acc += n;
    }
    float meanLog = cnt > 0.0 ? sum / cnt : log2(post.expoB.z);
    float target = clamp(log2(post.expoB.z) - meanLog, post.expo.z, post.expo.w);
    vec4 prev = state;
    float adapted = target;
    if (post.expoB.w > 0.5 && !isnan(prev.x) && !isinf(prev.x)) {
        float speed = target > prev.x ? post.expoB.x : post.expoB.y;
        adapted = prev.x + (target - prev.x) * (1.0 - exp(-post.timing.x * speed));
    }
    state = vec4(adapted, target, meanLog, 1.0);
    imageStore(oExposure, ivec2(0), state);
}
