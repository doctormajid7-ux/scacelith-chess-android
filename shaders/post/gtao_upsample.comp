// Joint-bilateral upsampling of the half-resolution GTAO to the render resolution (depth and
// normal aware) and final shaping (power). Output RGBA8 on TEXUNIT_AO: r = AO.
#include "shaders/post/post_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D uAO;          // half res, r = visibility
layout(binding = 1) uniform sampler2D uHalfDepth;
layout(binding = 2) uniform sampler2D uHalfNormal;
layout(binding = 3) uniform sampler2D uLinearDepth; // full res
layout(binding = 4) uniform sampler2D uNormalRough; // full res
layout(binding = 0, rgba8) uniform writeonly image2D oAO;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(post.renderSize.xy)))) return;
    float z = texelFetch(uLinearDepth, p, 0).r;
    if (z >= SKY_DEPTH * 0.5) { imageStore(oAO, p, vec4(1.0)); return; }
    vec3 n = texelFetch(uNormalRough, p, 0).xyz;
    n = dot(n, n) > 1e-6 ? normalize(n) : vec3(0, 1, 0);
    ivec2 hsize = ivec2(post.halfSize.xy);
    vec2 hp = (vec2(p) + 0.5) * 0.5 - 0.5;
    ivec2 b = ivec2(floor(hp));
    vec2 f = hp - vec2(b);
    float sum = 0.0;
    float wsum = 0.0, bestDz = 1e30;
    float best = 1.0;
    float tol = 1.0 / (0.02 * z + 0.004);
    for (int k = 0; k < 4; ++k) {
        ivec2 o = ivec2(k & 1, k >> 1);
        ivec2 q = clamp(b + o, ivec2(0), hsize - 1);
        float zq = texelFetch(uHalfDepth, q, 0).r;
        vec3 nq = texelFetch(uHalfNormal, q, 0).xyz * 2.0 - 1.0;
        float v = texelFetch(uAO, q, 0).r;
        float bil = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float dz = abs(zq - z);
        float w = (bil + 1e-3) * exp(-dz * tol) * pow(saturate(dot(n, nq) * 0.5 + 0.5), 8.0);
        sum += v * w;
        wsum += w;
        if (dz < bestDz) { bestDz = dz; best = v; }
    }
    float v = wsum > 1e-4 ? sum / wsum : best;
    imageStore(oAO, p, vec4(pow(saturate(v), post.ao.y)));
}
